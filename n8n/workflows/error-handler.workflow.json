{
  "id": "BkLfErrorHandler",
  "name": "BookLeaf · Error handler",
  "nodes": [
    {
      "parameters": {
        "content": "## BookLeaf · Error handler\nSet as the **Error workflow** of *BookLeaf · Royalty Summary* (Workflow settings). Runs only when the main workflow crashes in a way its own error branches don't handle (for example a bug or an n8n outage mid-run). Bubble already got an HTTP 500 and marked the notification Failed; this marks the run as crashed in the Data Table and emails ops with a link to the execution.",
        "height": 420,
        "width": 1180,
        "color": 3
      },
      "id": "f7c0f955-708d-4062-a3b3-88c5ca665e0c",
      "name": "Note: error handler",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        80
      ]
    },
    {
      "parameters": {},
      "id": "c193e837-741f-49be-a42e-b7de05b80dc8",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "3896816c-0425-4eb3-af2f-af5225e63179",
              "name": "email_enabled",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "dd548219-6192-4b54-a637-8917ec5b481f",
              "name": "from_email",
              "value": "BookLeaf Author Relations <bookleaf.demo.inbox@example.com>",
              "type": "string"
            },
            {
              "id": "28c1c803-62ba-47ef-a21d-49d255a07161",
              "name": "ops_alert_recipient",
              "value": "bookleaf.demo.inbox@example.com",
