# Local n8n (Docker) or n8n Cloud production webhook URL
N8N_WEBHOOK_URL=http://localhost:5678/webhook/bookleaf/royalty-summary
# Same value as the "BookLeaf webhook key (X-BookLeaf-Key)" credential in n8n and the private header in Bubble's API Connector
N8N_WEBHOOK_KEY=
# Local Mailpit UI/API (local testing only)
MAILPIT_URL=http://localhost:8025
# Bubble app (for the Playwright tests), e.g. https://bookleaf-royalty.bubbleapps.io/version-test
BUBBLE_APP_URL=
DEMO_PASSWORD=BookLeaf@2026
